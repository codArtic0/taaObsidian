			"updated": 1778901454060,
			"locked": false,
			"text": "buscaMatriz(A, n, x){\n    encontrou = false\n    for(i = 0; i < n; i++){\n        for(j = 0; j < n; j++){\n            if(A[i][j] == x){\n                encontrou = true\n            }\n        }\n    }\n    return encontrou\n}",
			"rawText": "buscaMatriz(A, n, x){\n    encontrou = false\n    for(i = 0; i < n; i++){\n        for(j = 0; j < n; j++){\n            if(A[i][j] == x){\n                encontrou = true\n            }\n        }\n    }\n    return encontrou\n}",
