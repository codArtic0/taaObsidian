			"updated": 1779452561741,
			"locked": false,
			"text": "verificar_triangulo(a, b, c){\n    if (a + b > c and a + c > b and b + c > a){\n        \n        if (a == b and b == c){\n            print(\"Triângulo Equilátero\")\n        }\n        \n        else if (a != b and a != c and b != c){\n            print(\"Triângulo Escaleno\")\n        }\n        \n        else{\n            print(\"Triângulo Isósceles\")\n        }\n    \n    else{\n        print(\"Não é um triângulo\")\n    }\n}",
			"rawText": "verificar_triangulo(a, b, c){\n    if (a + b > c and a + c > b and b + c > a){\n        \n        if (a == b and b == c){\n            print(\"Triângulo Equilátero\")\n        }\n        \n        else if (a != b and a != c and b != c){\n            print(\"Triângulo Escaleno\")\n        }\n        \n        else{\n            print(\"Triângulo Isósceles\")\n        }\n    \n    else{\n        print(\"Não é um triângulo\")\n    }\n}",
			"fontSize": 20,
			"fontFamily": 6,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "verificar_triangulo(a, b, c){\n    if (a + b > c and a + c > b and b + c > a){\n        \n        if (a == b and b == c){\n            print(\"Triângulo Equilátero\")\n        }\n        \n        else if (a != b and a != c and b != c){\n            print(\"Triângulo Escaleno\")\n        }\n        \n        else{\n            print(\"Triângulo Isósceles\")\n        }\n    \n    else{\n        print(\"Não é um triângulo\")\n    }\n}",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
