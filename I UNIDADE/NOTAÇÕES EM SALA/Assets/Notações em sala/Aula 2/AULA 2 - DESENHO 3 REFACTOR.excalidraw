			"updated": 1778899601670,
			"locked": false,
			"text": "multiplicaMatriz(A,B,n) {\n    for (i=0; i<n; i++){\n        for(j=0; j<n; j++){\n            Cij = 0\n            for (k=0; k<n; k++){\n                Cij = Cij + Aij * Bij\n            }\n        }\n    }\n    return C\n}",
			"rawText": "multiplicaMatriz(A,B,n) {\n    for (i=0; i<n; i++){\n        for(j=0; j<n; j++){\n            Cij = 0\n            for (k=0; k<n; k++){\n                Cij = Cij + Aij * Bij\n            }\n        }\n    }\n    return C\n}",
			"fontSize": 26.408924271719094,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "multiplicaMatriz(A,B,n) {\n    for (i=0; i<n; i++){\n        for(j=0; j<n; j++){\n            Cij = 0\n            for (k=0; k<n; k++){\n                Cij = Cij + Aij * Bij\n            }\n        }\n    }\n    return C\n}",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
